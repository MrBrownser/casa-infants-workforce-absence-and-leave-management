# Copy this file to `.env.local` and fill in real values.
# `.env*` files are gitignored; Next.js and the Prisma CLI (prisma.config.ts) both
# read `.env.local`. Never commit secrets.
#
# Local `.env.local` points at the DEV Supabase project and the Clerk development
# instance. Production credentials live only in the Vercel project settings.

# ── Database: Supabase Postgres (EU, eu-west-1) ──────────────────────────────
# Transaction-mode pooler (port 6543), used at RUNTIME by Prisma Client.
# pgbouncer=true is required for the transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (port 5432), used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Clerk: auth ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."   # public key, safe to expose to the client
CLERK_SECRET_KEY="sk_test_..."                    # server-only, never expose to the client
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"
