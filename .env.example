# Copy this file to `.env` and fill in real values.
# `.env` is gitignored; both Next.js and the Prisma CLI read it. Never commit secrets.

# ── Database: Supabase Postgres (EU region) ──────────────────────────────────
# Pooled connection (Supavisor, port 6543) — used at RUNTIME by Prisma Client.
# pgbouncer=true is required for the transaction pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Clerk: auth ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."   # public key, safe to expose to the client
CLERK_SECRET_KEY="sk_test_..."                    # server-only, never expose to the client
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"          # path to the sign-in page
